# Shared by Make and CMake: explicit simple assignments, one line each.
# Shared cases use the original host/device capture bodies and fmt host object.
FFMT_SHARED_TESTS := integers floats strings layout misc formatter
FFMT_BUFFER_TESTS := buffer_path
FFMT_HOST_ONLY_TESTS := features

# Direct assertions inspect memory, errors and extension APIs without a new runner.
FFMT_DIRECT_TESTS := chrono core_accounting core_conversion core_floating core_floating_portable core_format_as core_formatters core_forwarding core_int128 core_legacy core_migration core_parsing core_primitives core_unicode engine_bitint engine_extended engine_fast_math engine_legacy_hook engine_quad engine_transport enum family_support feature_integration formatter_composition legacy_forwarding named_arguments printf ranges ranges_forwarding ranges_iterators std style transport_forwarding
FFMT_DIRECT_CXX23_TESTS := std23

FFMT_DIRECT_REFERENCE_chrono := 1
FFMT_DIRECT_OPTIONAL_chrono := 0
FFMT_DIRECT_REFERENCE_core_accounting := 0
